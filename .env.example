# Shared client/server configuration. Copy this file to `.env` in the repository
# root. Values in `client/.env` or `server/.env` override matching root values.
# CRA only exposes `REACT_APP_*` variables to browser code; never use that prefix
# for secrets.

# OSRS cache base URL (trailing slash optional). Default: /caches/
# REACT_APP_CACHE_BASE_URL=https://game.example.com/caches/

# Default WebSocket endpoint before the player picks a server.
# REACT_APP_DEFAULT_WS_URL=wss://game.example.com

# Defaults shown on the login "server" button.
# REACT_APP_DEFAULT_SERVER_ADDRESS=game.example.com
# REACT_APP_DEFAULT_SERVER_NAME=My Server
# REACT_APP_DEFAULT_SERVER_SECURE=true

# Optional JSON array baked into the client (skips fetching /servers.json).
# REACT_APP_SERVERS_JSON=[{"name":"My Server","address":"game.example.com","secure":true,"maxPlayers":2047}]

# Optional remote server-list URL. Default: same-origin /servers.json
# REACT_APP_SERVER_LIST_URL=/servers.json

# Optional shared WebRTC relay configuration. The client receives only the
# public URL and ICE configuration; server registration values remain private.
# WEBRTC_SIGNAL_URL=wss://relay.example.com
# WEBRTC_ICE_SERVERS=[{"urls":"stun:relay.example.com:3478"}]
# WEBRTC_WORLD_ID=my-world
# Set the display name with "name" in server/data/definitions/world.local.json.
# WEBRTC_WORLD_TOKEN=replace-with-registration-token
# Dedicated worlds can advertise direct WebSocket gameplay while the relay
# continues to receive player counts over /signal.
# WORLD_WEBSOCKET_URL=wss://game.example.com

FAST_REFRESH=false

# AI bots (server/docs/ai-bots.md): the model backends they may use. Only providers with a
# key or URL here are used; enable the bots themselves in world config "PlayerBots:ai".
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_URL=http://localhost:11434

# Quest Helper bridge (tools/quest-helper-bridge/README.md). The server forwards client
# snapshots to this local Java process; without it only the native Tutorial Island and Recipe
# for Disaster routes answer. The agent MCP's quest_helper tool needs it for every other quest.
# Start it with `yarn bridge`. Any 24+ character secret works, as long as both sides see the
# same one. One bridge serves every worktree. Set QUEST_HELPER_URL when the bridge is not
# reachable at loopback from the server, for example http://quest-helper:16471.
# QUEST_HELPER_TOKEN=replace-with-32-random-bytes
# QUEST_HELPER_PORT=16471
# QUEST_HELPER_URL=http://127.0.0.1:16471
# QUEST_HELPER_JAVA_HOME=/path/to/jdk-21

# Optional native remembered login. Requires HTTPS proxying.
# 0 disables the loopback-only HTTP broker. Do not expose it directly.
GATEWAY_LOGIN_HTTP_PORT=0
# Enable only when native clients arrive through a trusted local TCP forwarder.
GATEWAY_LOGIN_TRUST_LOOPBACK_PROXY=false

# ---------------------------------------------------------------------------
# Docker / Docker Compose (docs/docker.md). Ignored by `yarn start`.
# ---------------------------------------------------------------------------

# Image tag: latest follows main, stable follows released tags. Pin a semver or sha-<commit>
# for a deployment you update by hand.
# TSPS_IMAGE_TAG=latest

# Hostname or IP players use to reach the game. The container writes this into the client's
# servers.json at startup, so changing it does not rebuild the image.
# PUBLIC_HOST=game.example.com

# Host ports. GAME_PORT is also the port written into servers.json.
# GAME_PORT=43594
# CLIENT_PORT=3000

# Login-page server entry (name, wss) and the world's advertised cap.
# SERVER_NAME=My Server
# SERVER_SECURE=false
# MAX_PLAYERS=2047

# World-admin page (not published by default; see compose.admin.yaml). The server only binds
# beyond loopback with a token of at least 24 characters A-Z a-z 0-9 _ - and TLS for remote use.
# WORLD_ADMIN_TOKEN=replace-with-at-least-24-random-characters
# WORLD_ADMIN_BIND=0.0.0.0
# WORLD_ADMIN_PORT=49600
# WORLD_ADMIN_TLS_CERT=/data/tls/cert.pem
# WORLD_ADMIN_TLS_KEY=/data/tls/key.pem

# Only for scripts/docker-update.sh: how much warning players get before a restart.
# TSPS_UPDATE_DELAY=5m

# Non-Docker installs: move mutable state (saves, world.local.json, logs, cache) to one
# directory. Unset keeps the historical server/data, server/logs and server/caches paths.
# TSPS_DATA_DIR=/srv/tsps-data
# TSPS_CACHE_DIR=/srv/tsps-data/caches
# TSPS_LOG_DIR=/srv/tsps-data/logs

# IANA time zone for the container (logs and in-game time formatting).
# TZ=UTC

